{
  "name": "wildrune-web-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "WILDRUNE: The Forgotten Lands — self-contained browser action RPG prototype.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node WebPrototype/tools/build.mjs",
    "start": "node WebPrototype/tools/serve.mjs",

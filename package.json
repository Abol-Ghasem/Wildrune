    "test": "node WebPrototype/tests/run_tests.js && node WebPrototype/tests/build_tests.mjs",
    "test:logic": "node WebPrototype/tests/run_tests.js",
    "test:browser": "npm run build && node WebPrototype/tests/browser_smoke.mjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.65.1"
  }
}
